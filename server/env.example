# Copy this file to .env and fill in your values.

# Port the API listens on.
PORT=8787

# Get a key at https://serpapi.com (free tier available). Powers the real
# product image/name/price results.
SERPAPI_KEY=your_serpapi_key_here

# Your frontend's origin, so the browser is allowed to call this API.
# Vite's default dev server port is 5173 — change if yours differs.
CORS_ORIGIN=http://localhost:5173
